#!/bin/bash
# DGX Spark Controller app launcher, generated by packaging/macos/build_app.sh.
#
# The bundle is a thin shell around the repository checkout: code, virtualenv
# and configuration stay in the repository, so updating the checkout updates
# the app. Set DGX_CONTROLLER_REPO to point the app at another checkout.
# Quitting the app stops only the local service; remote models keep running.
set -euo pipefail

baked_repo=@REPO@
repo="${DGX_CONTROLLER_REPO:-$baked_repo}"
python="$repo/.venv/bin/python"

if [[ ! -x "$python" ]]; then
  /usr/bin/osascript - "$python" >/dev/null 2>&1 <<'APPLESCRIPT' || true
on run argv
  display alert "DGX Spark Controller could not start" message ("The project Python is missing:" & return & item 1 of argv & return & return & "Create the virtualenv as described in docs/INSTALL.md, then reopen the app.") as critical
end run
APPLESCRIPT
  exit 1
fi

# Older macOS releases pass a -psn_* process serial number argument.
args=()
for arg in "$@"; do
  [[ "$arg" == -psn_* ]] || args+=("$arg")
done

# Finder starts apps with a minimal environment; use the system tools only.
export PATH="/usr/bin:/bin:/usr/sbin:/sbin"
cd "$repo"
exec "$python" -m controller.launcher ${args[@]+"${args[@]}"}
